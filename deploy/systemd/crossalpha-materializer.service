[Unit]
Description=CrossAlpha bounded Rust canonical/feature materializer
After=crossalpha-observatory.service

[Service]
Type=oneshot
WorkingDirectory=@REPO_DIR@
EnvironmentFile=-@REPO_DIR@/.env
ExecStart=@REPO_DIR@/target/release/crossalpha-materialize-rs --data-root @DATA_ROOT@ --recent-days 2 --scope all --allow-production-write
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
