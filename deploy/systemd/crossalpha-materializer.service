[Unit]
Description=CrossAlpha Observatory and shadow-state materializer
After=crossalpha-observatory.service

[Service]
Type=oneshot
WorkingDirectory=%h/CrossAlpha
EnvironmentFile=%h/CrossAlpha/.env
ExecStart=%h/CrossAlpha/.venv/bin/python scripts/materialize_observatory_and_state.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
